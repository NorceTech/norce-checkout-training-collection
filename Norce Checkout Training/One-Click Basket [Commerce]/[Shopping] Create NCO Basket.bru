meta {
  name: [Shopping] Create NCO Basket
  type: http
  seq: 1
}

post {
  url: {{commerceShoppingServiceUrl}}/CreateBasket?ipAddress=127.0.0.1
  body: json
  auth: inherit
}

params:query {
  ipAddress: 127.0.0.1
}

headers {
  Content-Type: application/json
  applicationId: {{commerceApplicationId}}
}

body:json {
  {
    "CustomerId": 56,
    "Items": [
      {
        "PartNo": "dtextreme",
        "Quantity": 1    
      }
    ],  
    "PaymentMethodId": 239,
    "DeliveryMethodId": 128
  }
}

vars:post-response {
  basketId: res.body.Id
}

assert {
  res.status: eq 200
  res('Id'): isDefined
}

docs {
  # One-Click Basket

  Creates a fully prepared basket in a single request: customer, items, payment method and delivery method.

  `CustomerId` 56 is Nora Ehandell, a Commerce customer in playground with the address Kungsgatan 9, 111 43 Stockholm and `UseInvoiceAddressAsDeliveryAddress` set. Commerce sets buyer, payer and ship-to from the customer, and uses the invoice address as delivery address. Without a delivery address the purchase fails in Commerce at completion.

  The returned `basketId` is saved and ready to use in any **Purchase** flow.
}
