meta {
  name: [Shopping] Create NCO Basket
  type: http
  seq: 1
}

post {
  url: {{commerceShoppingServiceUrl}}/CreateBasket?ipAddress=127.0.0.1
  body: json
  auth: inherit
}

params:query {
  ipAddress: 127.0.0.1
}

headers {
  Content-Type: application/json
  applicationId: {{commerceApplicationId}}
}

body:json {
  {
    "CustomerId": 39,
    "Items": [
      {
        "PartNo": "dtextreme",
        "Quantity": 1    
      }
    ],  
    "PaymentMethodId": 239,
    "DeliveryMethodId": 128
  }
}

vars:post-response {
  basketId: res.body.Id
}

assert {
  res.status: eq 200
  res('Id'): isDefined
}

docs {
  # One-Click Basket

  Creates a fully prepared basket in a single request by passing customer, items, payment method and delivery method inline. This is a shortcut alternative to the step-by-step flow in the **Arrange Basket** folder.

  The returned `basketId` is saved and ready to use in any **Purchase** flow.
}
