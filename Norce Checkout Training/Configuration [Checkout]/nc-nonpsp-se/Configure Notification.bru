meta {
  name: Configure Notification
  type: http
  seq: 6
}

put {
  url: {{configurationUrl}}/api/v1/configuration/merchants/{{merchant}}/channels/{{channel}}/configurations/static_notifications
  body: json
  auth: inherit
}

headers {
  x-merchant: {{merchant}}
  x-channel: {{channel}}
}



body:json {
  {
    "$schema": "{{configurationUrl}}/openapi/v1/schemas/configuration.json",
    "id": "static_notifications",
    "active": true,
  "order": {
      "notifications": [
        {
          "description": "Cart changed",
          
          "scope": "/cart",
          "invoke": "{{webhooksiteurl}}"
        }
      ]
    }
  }

}

docs {
  # Configure Static Notification

  Sets up a channel-level notification that fires when the cart changes on any order. Unlike order-level notifications (added per order), static notifications apply to all orders on this channel. The `invoke` URL points to webhook.site for inspection during training.
}
