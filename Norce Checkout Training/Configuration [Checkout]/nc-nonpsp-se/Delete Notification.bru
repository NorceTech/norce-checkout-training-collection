meta {
  name: Delete Notification
  type: http
  seq: 8
}

delete {
  url: {{configurationUrl}}/api/v1/configuration/merchants/{{merchant}}/channels/{{channel}}/configurations/static_notifications
  body: none
  auth: inherit
}

headers {
  x-merchant: {{merchant}}
  x-channel: {{channel}}
}

docs {
  # Delete Static Notification

  Removes the static notification configuration for this channel. Run this to clean up after testing notifications.
}
