meta {
  name: Update Admin Meta
  type: http
  seq: 5
}

put {
  url: {{configurationUrl}}/api/v1/configuration/merchants/{{merchant}}/channels/{{channel}}/configurations/admin_meta
  body: json
  auth: inherit
}

headers {
  x-merchant: {{merchant}}
  x-channel: {{channel}}
}

body:json {
  {
    "$schema": "http://{{slug}}.checkoutadmin-se{{environment}}.norce.tech/api/schemas/v1/admin_meta_schema.json",
    "id": "admin_meta",
    "configs": [
      {
        "schema": "https://{{slug}}.api-se{{environment}}.norce.tech/checkout/norce-adapter/openapi/v2/schemas/norce_adapter.json",
        "id": "norce_adapter",
        "imgUrl": "/norce-logo-black.svg",
        "tags": [
          "Platform"
        ]
      },
      {
        "schema": "https://{{slug}}.api-se{{environment}}.norce.tech/checkout/walley-adapter/openapi/v1/schemas/walley_checkout_adapter.json",
        "id": "walley_checkout_adapter",
        "imgUrl": "/walley.png",
        "tags": [
          "Payment"
        ]
      }
    ],
    "active": true
  }
}

docs {
  # Update Admin Meta
  
  Configures the admin UI metadata for this channel. This tells the Checkout admin which adapter configurations exist and how to display them (icons, tags). Each entry points to the adapter's JSON schema for the admin to render a configuration form.
}
