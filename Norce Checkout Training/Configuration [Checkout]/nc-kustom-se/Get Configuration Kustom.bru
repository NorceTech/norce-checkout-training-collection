meta {
  name: Get Configuration Kustom
  type: http
  seq: 4
}

get {
  url: {{configurationUrl}}/api/v1/configuration/merchants/{{merchant}}/channels/{{channel}}/configurations/klarna_checkout_adapter
  body: json
  auth: inherit
}

headers {
  x-merchant: {{merchant}}
  x-channel: {{channel}}
}

docs {
  # Get Configuration Kustom

  Returns the currently stored Kustom / Klarna Checkout adapter configuration (`klarna_checkout_adapter`) for the `nc-kustom-se` channel. Use this to verify the configuration after running **Configure Kustom Adapter**.
}
