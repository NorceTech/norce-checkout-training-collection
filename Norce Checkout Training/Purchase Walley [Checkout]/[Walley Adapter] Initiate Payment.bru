meta {
  name: [Walley Adapter] Initiate Payment
  type: http
  seq: 3
}

post {
  url: {{walleyAdapterUrl}}/api/checkout/v1/orders/{{orderId}}/payments
  body: none
  auth: inherit
}

headers {
  x-merchant: {{merchant}}
  x-channel: {{channel}}
}



script:post-response {
  // Extraherar och sätter variabeln 'paymentId' från response body om statuskoden är 200 OK.
  if (res.status === 200) {
    const paymentIdFromBody = res.body.paymentId;
    if (paymentIdFromBody !== undefined) {
      bru.setVar('paymentId', paymentIdFromBody);
      console.log('Variabeln paymentId uppdaterad till: ' + paymentIdFromBody);
    } else {
      console.log('Status var 200 OK, men paymentId saknades i response body.');
    }
  } else {
    console.log('Status var ' + res.status + '. Variabeln paymentId lämnades oförändrad.');
  }
}

assert {
  res.status: eq 200
}

docs {
  # Initiate Payment (Walley)

  Starts a Walley payment session for the order. The response contains the `paymentId` (saved for later use) and snippet data that a frontend would embed to render the Walley checkout widget.

  In a real integration, the customer interacts with the Walley hosted snippet. Completion happens via Walley's server-to-server callback.
}
