meta {
  name: [Kustom Adapter] Initiate Payment
  type: http
  seq: 3
}

post {
  url: {{kustomAdapterUrl}}/api/checkout/v1/orders/{{orderId}}/payments
  body: none
  auth: inherit
}

headers {
  x-merchant: {{merchant}}
  x-channel: {{channel}}
}

script:post-response {
  // Saves 'paymentId' from the response body when the status is 200 OK.
  // Kustom also returns an htmlSnippet that the frontend embeds to render the checkout iframe (see web/checkout.html).
  if (res.status === 200) {
    const paymentIdFromBody = res.body.paymentId || res.body.id;
    if (paymentIdFromBody !== undefined) {
      bru.setVar('paymentId', paymentIdFromBody);
      console.log('paymentId set to: ' + paymentIdFromBody);
    } else {
      console.log('Status 200 OK, but paymentId/id was missing in the response body.');
    }
    if (res.body.htmlSnippet !== undefined) {
      console.log('htmlSnippet received. Paste the response into web/checkout.html to render the Kustom checkout.');
    }
  } else {
    console.log('Status ' + res.status + '. paymentId left unchanged.');
  }
}

assert {
  res.status: eq 200
}

docs {
  # Initiate Payment (Kustom / Klarna Checkout)

  Starts a **Kustom Checkout** payment session for the order via the `klarna_checkout_adapter`. Kustom is the new name for Klarna Checkout (KCO); in Norce Checkout it is the same adapter — see **Configure Kustom Adapter** for details.

  The response contains the payment id (saved as `paymentId`) and an `htmlSnippet`. In a real integration the frontend embeds the `htmlSnippet` to render the hosted Kustom/Klarna checkout iframe, where the customer completes the purchase. Completion is then confirmed via Kustom's server-to-server callback, which the adapter uses to advance the order state.

  This mirrors the Walley flow (both are hosted-checkout PSPs); compare the two to see how Norce Checkout normalises different providers behind the same order model.
}
