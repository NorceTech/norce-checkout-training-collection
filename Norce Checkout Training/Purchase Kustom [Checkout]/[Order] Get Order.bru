meta {
  name: [Order] Get Order
  type: http
  seq: 2
}

get {
  url: {{orderUrl}}/api/v1/checkout/orders/{{orderId}}
  body: none
  auth: inherit
}

headers {
  x-merchant: {{merchant}}
  x-channel: {{channel}}
}

vars:post-response {
  cartItemId: res.body.cart.items[0].id
}

assert {
  res.status: eq 200
}

docs {
  # Get Order

  Retrieves the current state of the Checkout order. Useful for inspecting the order after each operation to see how it evolves through the state machine.

  The first cart item's `id` is saved as `cartItemId` for use in cart update operations.
}
