meta {
  name: [Order] Add Validation Fails
  type: http
  seq: 4
}

post {
  url: {{orderUrl}}/api/v1/checkout/orders/{{orderId}}/validations
  body: json
  auth: inherit
}

headers {
  x-merchant: {{merchant}}
  x-channel: {{channel}}
}

body:json {
  {
    "invoke": "https://400.returnco.de/validation-fail",
    "adapterId": "fail_verify"
  }
}

assert {
  res.status: eq 200
}

docs {
  # Add Validation (Fail)

  Registers an external validation that is designed to fail (the invoke URL returns HTTP 400). Use this to test how Checkout handles validation failures — the order will not be completable until this validation is removed or replaced with one that succeeds.
}
