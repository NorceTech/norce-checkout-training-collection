meta {
  name: [Non-PSP Adapter] Complete Payment
  type: http
  seq: 11
}

post {
  url: {{nonpspAdapterUrl}}/api/checkout/v1/orders/{{orderId}}/payments/{{paymentId}}/complete
  body: none
  auth: inherit
}

headers {
  x-merchant: {{merchant}}
  x-channel: {{channel}}
}

assert {
  res.status: eq 200
}

docs {
  # Complete Payment

  Completes the Non-PSP payment and moves the order to `completed` state. All validations must pass before this succeeds. After this, the order is finalized.
}
