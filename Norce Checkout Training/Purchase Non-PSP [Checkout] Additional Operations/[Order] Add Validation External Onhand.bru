meta {
  name: [Order] Add Validation External Onhand
  type: http
  seq: 13
}

post {
  url: {{orderUrl}}/api/v1/checkout/orders/{{orderId}}/validations
  body: json
  auth: inherit
}

headers {
  x-merchant: {{merchant}}
  x-channel: {{channel}}
}

body:json {
  {
    "invoke": "{{webhooksiteurl}}/validate",
    "adapterId": "onhand_verify"
  }
}

assert {
  res.status: eq 200
}

docs {
  # Add External Validation (Onhand)

  Registers an external validation that calls webhook.site on order validation. This simulates an external stock/on-hand check. Since webhook.site returns 200, this validation will pass. Compare with **Add Validation Fail** to see how a failing validation blocks completion.
}
