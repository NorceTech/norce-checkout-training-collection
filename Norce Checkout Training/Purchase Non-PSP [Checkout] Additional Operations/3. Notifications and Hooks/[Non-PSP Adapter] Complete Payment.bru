meta {
  name: [Non-PSP Adapter] Complete Payment
  type: http
  seq: 5
}

post {
  url: {{nonpspAdapterUrl}}/api/checkout/v1/orders/{{orderId}}/payments/{{paymentId}}/complete
  body: none
  auth: inherit
}

headers {
  x-merchant: {{merchant}}
  x-channel: {{channel}}
}

assert {
  res.status: eq 202
}

docs {
  # Complete Payment

  Completes the Non-PSP payment and moves the order to `completed`. The adapter answers `202 Accepted`.

  Note: the Non-PSP adapter does **not** call the registered validations here. Only the order's built-in checks run on the way through `processing`. Hooks on `/state` and notifications on `/state/currentStatus` are invoked during the transition.
}
