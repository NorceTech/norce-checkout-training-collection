meta {
  name: [Order] Customer Billing
  type: http
  seq: 8
}

put {
  url: {{orderUrl}}/api/v0/checkout/orders/{{orderId}}/customer/billing
  body: json
  auth: inherit
}

headers {
  x-merchant: {{merchant}}
  x-channel: {{channel}}
}

body:json {
  {
      "type": "Person",
      "givenName": "Bill",
      "familyName": "Billsson",
      "streetAddress": "Billroad 10",
      "postalCode": "41123",
      "city": "Billsson",
      "country": "SE",
      "phone": "+46 70 011 22 33",
      "email": "bill@example.com",
      "attributes": {
          "nationalIdentificationNumber": null,
          "dateOfBirth": null,
          "vatId": null
      }
  }
}

assert {
  res.status: eq 200
}

docs {
  # Customer Billing Address
  
  Sets the billing address directly on the Checkout order. Together with the shipping address, this demonstrates how customer details can be updated on the Checkout side independently of Commerce.
}
