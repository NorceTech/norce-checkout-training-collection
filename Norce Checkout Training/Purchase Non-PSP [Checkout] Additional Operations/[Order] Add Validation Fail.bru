meta {
  name: [Order] Add Validation Fail
  type: http
  seq: 14
}

post {
  url: {{orderUrl}}/api/v1/checkout/orders/{{orderId}}/validations
  body: json
  auth: inherit
}

headers {
  x-merchant: {{merchant}}
  x-channel: {{channel}}
}

body:json {
  {
    "invoke": "https://400.returnco.de/whatever",
    "adapterId": "onhand_verify"
  }
}

assert {
  res.status: eq 200
}

docs {
  # Add Validation (Fail)

  Registers an external validation that always fails (the invoke URL returns HTTP 400). This demonstrates how Checkout blocks order completion when a validation fails. Remove this validation or replace the URL to allow the order to proceed.
}
