meta {
  name: [Order] Validate Order
  type: http
  seq: 10
}

post {
  url: {{orderUrl}}/api/v1/checkout/orders/{{orderId}}/validate
  body: none
  auth: inherit
}

headers {
  x-merchant: {{merchant}}
  x-channel: {{channel}}
}

assert {
  res.status: eq 200
}

docs {
  # Validate Order

  Runs all registered validations on the order. This includes both the built-in Norce Adapter validation and any external validations added via the validations endpoint. If any validation fails, the order cannot proceed to completion.
}
