meta {
  name: [Order] Add Hook State
  type: http
  seq: 15
}

post {
  url: {{orderUrl}}/api/v1/checkout/orders/{{orderId}}/hooks
  body: json
  auth: inherit
}

headers {
  x-merchant: {{merchant}}
  x-channel: {{channel}}
}

body:json {
  {
    "version": "v0",
    "scope": "/state",
    "invoke": "{{webhooksiteurl}}",
    "adapterId": "external_reserve"
  }
}

assert {
  res.status: eq 200
}

docs {
  # Add Hook (State Change)

  Registers a hook that fires on any state change of the order. Hooks differ from notifications in that they are synchronous — the state transition waits for the hook to respond. This can be used for external reservation systems that need to confirm before the order proceeds.
}
