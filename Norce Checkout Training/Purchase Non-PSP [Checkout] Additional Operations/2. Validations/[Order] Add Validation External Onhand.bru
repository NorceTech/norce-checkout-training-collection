meta {
  name: [Order] Add Validation External Onhand
  type: http
  seq: 2
}

post {
  url: {{orderUrl}}/api/v1/checkout/orders/{{orderId}}/validations
  body: json
  auth: inherit
}

headers {
  x-merchant: {{merchant}}
  x-channel: {{channel}}
}

body:json {
  {
    "invoke": "{{webhooksiteurl}}/validate",
    "adapterId": "onhand_verify"
  }
}

assert {
  res.status: eq 200
}

docs {
  # Add External Validation (Onhand)

  Registers an external validation that calls your webhook.site URL when the order is validated. This simulates an external stock/on-hand check. A 2xx answer passes the validation. Open webhook.site to see the order payload Checkout sends.

  Validations can only be added while the order is in `checkout` state.
}
