meta {
  name: [Order] Get Order
  type: http
  seq: 6
}

get {
  url: {{orderUrl}}/api/v1/checkout/orders/{{orderId}}
  body: none
  auth: inherit
}

headers {
  x-merchant: {{merchant}}
  x-channel: {{channel}}
}

vars:post-response {
  cartItemId: res.body.cart.items[0].id
}

assert {
  res.status: eq 200
}

tests {
  test("Response contains property 'shippings'", () => {
    expect(res.body).to.have.property("shippings");
  });

}

docs {
  # Get Order

  The registered validations are listed under `validations` on the order.
}
