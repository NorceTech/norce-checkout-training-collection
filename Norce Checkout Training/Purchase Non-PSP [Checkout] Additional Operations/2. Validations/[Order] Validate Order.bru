meta {
  name: [Order] Validate Order
  type: http
  seq: 3
}

post {
  url: {{orderUrl}}/api/v1/checkout/orders/{{orderId}}/validate
  body: none
  auth: inherit
}

headers {
  x-merchant: {{merchant}}
  x-channel: {{channel}}
}

assert {
  res.status: eq 200
}

docs {
  # Validate Order

  Runs the order's built-in checks and calls every registered validation. With only the `webhooksiteurl` validation registered this returns `200 OK`.
}
