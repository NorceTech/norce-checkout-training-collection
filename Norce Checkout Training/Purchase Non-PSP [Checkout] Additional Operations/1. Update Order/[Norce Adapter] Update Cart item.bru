meta {
  name: [Norce Adapter] Update Cart item
  type: http
  seq: 3
}

patch {
  url: {{norceAdapterUrl}}/api/v1/orders/{{orderId}}/cart/items/{{cartItemId}}
  body: json
  auth: inherit
}

headers {
  x-merchant: {{merchant}}
  x-channel: {{channel}}
}

body:json {
  {
    "quantity":2
  }
}

assert {
  res.status: eq 200
}

docs {
  # Update Cart Item

  Updates the quantity of the first cart item (`cartItemId` from **Get Order**) via the Norce Adapter, which updates the Commerce basket.
}
