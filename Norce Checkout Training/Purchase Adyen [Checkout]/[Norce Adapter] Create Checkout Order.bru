meta {
  name: [Norce Adapter] Create Checkout Order
  type: http
  seq: 1
}

post {
  url: {{norceAdapterUrl}}/api/v1/orders
  body: json
  auth: inherit
}

headers {
  x-merchant: {{merchant}}
  x-channel: {{channel}}
}


body:json {
  {
    "cartReference": {{basketId}},
    "culture": "sv-SE"
  }
}

script:post-response {
  // Saves 'orderId' from the response body when the status is 201 Created.
  if (res.status === 201) {
    const orderIdFromBody = res.body.id;
  
    if (orderIdFromBody !== undefined) {
      bru.setVar('orderId', orderIdFromBody);
      console.log('orderId set to: ' + orderIdFromBody);
    } else {
      console.log('Status 201 Created, but id was missing in the response body.');
    }
  } else {
    console.log('Status ' + res.status + '. orderId left unchanged.');
  }
}

assert {
  res.status: eq 201
}

docs {
  # Create Checkout Order

  Imports the Commerce basket into Norce Checkout via the Norce Adapter. The `cartReference` is the `basketId` from the Arrange Basket step.

  On success (201 Created), the response contains the Checkout `orderId` which is saved for all subsequent requests in this flow.
}
