meta {
  name: [Shopping] Update Payment Method
  type: http
  seq: 4
}

post {
  url: {{commerceShoppingServiceUrl}}/UpdatePaymentMethod?paymentMethodId=239&basketId={{basketId}}
  body: none
  auth: inherit
}

params:query {
  paymentMethodId: 239
  basketId: {{basketId}}
}

headers {
  Content-Type: application/json
  applicationId: {{commerceApplicationId}}
}

assert {
  res.status: eq 200
  res('Basket.Id'): eq {{basketId}}
}

docs {
  # Update Payment Method

  Sets the payment method on the basket. The `paymentMethodId` must match a payment method configured in the Commerce application. This call uses `body: none` — the payment method is set via the query parameter.
}
