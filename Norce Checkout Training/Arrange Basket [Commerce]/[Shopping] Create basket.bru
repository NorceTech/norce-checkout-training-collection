meta {
  name: [Shopping] Create basket
  type: http
  seq: 1
}

post {
  url: {{commerceShoppingServiceUrl}}/CreateBasket?ipAddress=127.0.0.1&createdBy=1&format=json
  body: json
  auth: inherit
}

params:query {
  ipAddress: 127.0.0.1
  createdBy: 1
  format: json
}

headers {
  Content-Type: application/json
  applicationId: {{commerceApplicationId}}
}

body:json {
  {}
}

vars:post-response {
  basketId: res.body.Id
}

assert {
  res.status: eq 200
  res('Id'): isDefined
}

docs {
  # Create Basket

  Creates a new empty shopping basket in Norce Commerce. The returned basket `Id` is automatically saved as `basketId` and used by all subsequent requests in this folder.

  This is the starting point for the step-by-step basket flow. For a quicker alternative, see the **One-Click Basket** folder.
}
