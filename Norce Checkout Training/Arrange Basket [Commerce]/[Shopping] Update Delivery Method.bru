meta {
  name: [Shopping] Update Delivery Method
  type: http
  seq: 5
}

post {
  url: {{commerceShoppingServiceUrl}}/UpdateDeliveryMethod4?basketId={{basketId}}&format=json
  body: json
  auth: inherit
}

params:query {
  basketId: {{basketId}}
  format: json
}

headers {
  Content-Type: application/json
  applicationId: {{commerceApplicationId}}
}

body:json {
  { 
      "Id": 130
  }
}

assert {
  res.status: eq 200
  res('Basket.Id'): eq {{basketId}}
}

docs {
  # Update Delivery Method

  Sets the delivery method on the basket. This is the last step before the basket is ready to be exported to Norce Checkout. After running all five steps in this folder, move to one of the **Purchase** folders to import the basket as a Checkout order.
}
