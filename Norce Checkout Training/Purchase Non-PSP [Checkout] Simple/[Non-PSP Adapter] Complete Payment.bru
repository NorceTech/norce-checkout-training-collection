meta {
  name: [Non-PSP Adapter] Complete Payment
  type: http
  seq: 7
}

post {
  url: {{nonpspAdapterUrl}}/api/checkout/v1/orders/{{orderId}}/payments/{{paymentId}}/complete
  body: none
  auth: inherit
}

headers {
  x-merchant: {{merchant}}
  x-channel: {{channel}}
}

assert {
  res.status: eq 202
}

docs {
  # Complete Payment

  Completes the Non-PSP payment and moves the order to `completed` state. The adapter answers `202 Accepted`. This is the last payment step in the simple flow; run **Get Order (after complete)** to see the completed state.
}
